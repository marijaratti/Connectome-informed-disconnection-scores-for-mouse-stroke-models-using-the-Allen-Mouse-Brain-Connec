"""Toy connectome-informed disconnection score for the three Brezzo et al. stroke models.

Usage: python3 -I disconnection_score.py <W_ipsi.csv> <W_contra.csv> <out_dir>

W matrices: Oh et al. 2014 (Nature) Allen mesoscale connectome, regional linear model.
Rows = source region, columns = target region (normalised connection strength).

Lesion extents below are ILLUSTRATIVE assumptions (fraction of each region damaged),
based on Brezzo et al.'s histology summary (dMCAO/DH ~12% of hemisphere, cortical;
tMCAO larger, cortex + striatum, more hippocampal/thalamic involvement) and typical
model territories. Real analysis would use each study's reported histology.
"""
import sys, json
import pandas as pd
import numpy as np

w_ipsi = pd.read_csv(sys.argv[1], index_col=0)
w_contra = pd.read_csv(sys.argv[2], index_col=0)
out_dir = sys.argv[3]

# Stroke is unilateral: use ipsilateral wiring (lesioned hemisphere's own circuit).
W = w_ipsi.astype(float)
W.values[np.diag_indices_from(W)] = 0.0

lesions = {
    "dMCAO": {"SSp-bfd": 0.6, "SSp-ul": 0.4, "SSp-ll": 0.3, "SSp-tr": 0.3,
              "SSs": 0.3, "MOp": 0.2, "PTLp": 0.2},
    "dMCAO + hypoxia": {"SSp-bfd": 0.7, "SSp-ul": 0.5, "SSp-ll": 0.4, "SSp-tr": 0.4,
                        "SSs": 0.4, "MOp": 0.25, "PTLp": 0.3, "CA1": 0.05},
    "tMCAO": {"CP": 0.7, "SSp-bfd": 0.5, "SSp-ul": 0.4, "SSs": 0.6, "MOp": 0.3,
              "AId": 0.4, "AIp": 0.4, "GU": 0.5, "AUDp": 0.3, "AUDd": 0.3,
              "TEa": 0.3, "CA1": 0.1, "VPM": 0.1, "VPL": 0.1},
}

circuits = {
    "Spatial (Barnes / water maze)": ["CA1", "CA3", "DG", "ENTl", "ENTm", "SUBd", "SUBv",
                                      "RSPagl", "RSPd", "RSPv", "PRE", "POST", "PAR"],
    "Recognition (NOR)": ["PERI", "ECT", "ENTl", "CA1", "PL", "ILA"],
    "Motor": ["MOp", "MOs", "CP", "VAL"],
}

for regs in list(lesions.values()) + list(circuits.values()):
    for r in regs:
        assert r in W.index, r

rows = []
for model, les in lesions.items():
    f = pd.Series(0.0, index=W.index)
    for r, v in les.items():
        f[r] = v
    for cname, circ in circuits.items():
        circ = list(circ)
        # Direct damage: mean fraction of the circuit's own regions destroyed.
        direct = float(f[circ].mean())
        # Network disconnection: share of the circuit's total connection strength
        # (inputs + outputs with the rest of the brain) that runs to/from lesioned tissue,
        # weighted by how much of each partner region is damaged.
        others = [r for r in W.index if r not in circ]
        conn = W.loc[others, circ].sum(axis=1) + W.loc[circ, others].sum(axis=0)
        network = float((conn * f[others]).sum() / conn.sum())
        rows.append({"model": model, "circuit": cname,
                     "direct_damage": round(direct, 3),
                     "network_disconnection": round(network, 3)})

df = pd.DataFrame(rows)
df.to_csv(f"{out_dir}/brezzo_disconnection_scores.csv", index=False)

# Top contributing lesioned regions to the spatial circuit, per model
contrib = {}
circ = circuits["Spatial (Barnes / water maze)"]
for model, les in lesions.items():
    d = {}
    for r, v in les.items():
        if r in circ:
            continue
        d[r] = round(float(v * (W.loc[r, circ].sum() + W.loc[circ, r].sum())), 4)
    contrib[model] = dict(sorted(d.items(), key=lambda x: -x[1])[:4])

print(df.pivot(index="model", columns="circuit", values="network_disconnection"))
print(df.pivot(index="model", columns="circuit", values="direct_damage"))
print(json.dumps(contrib, indent=1))
with open(f"{out_dir}/spatial_contributors.json", "w") as fh:
    json.dump(contrib, fh, indent=1)
